---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "SolveSteps - Interactive tools that help you solve real-life situations step by step", image = "/og-image.png" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #1f2937;
        background-color: #fafafa;
      }
    </style>
  </head>
  <body>
    <nav class="sticky top-0 bg-white border-b border-gray-200 shadow-sm z-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center gap-2">
            <a href="/" class="text-2xl font-bold text-blue-600">SolveSteps</a>
            <span class="text-xs text-gray-500">Situation Solver</span>
          </div>
          <div class="flex gap-6">
            <a href="/situations" class="text-sm text-gray-700 hover:text-blue-600">Tools</a>
            <a href="/about" class="text-sm text-gray-700 hover:text-blue-600">About</a>
            <a href="/contact" class="text-sm text-gray-700 hover:text-blue-600">Contact</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-3 gap-8 text-sm">
          <div>
            <h4 class="font-semibold mb-4">Company</h4>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/about" class="hover:text-blue-600">About Us</a></li>
              <li><a href="/contact" class="hover:text-blue-600">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Legal</h4>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/privacy-policy" class="hover:text-blue-600">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-blue-606" class="hover:text-blue-600">Terms of Use</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Tools</h4>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/situations" class="hover:text-blue-600">All Situations</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 mt-8 pt-8">
          <p class="text-xs text-gray-500 text-center">
            © 2024 SolveSteps. All rights reserved. These tools are provided as guidance only and should not replace professional advice.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact SolveSteps" description="Have questions, feedback, or suggestions? Get in touch with the SolveSteps team.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-8">Get in Touch</h1>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">We'd Love to Hear From You</h2>
        <p class="text-gray-700 mb-6">
          Have feedback about SolveSteps? Found a bug? Have a suggestion for a new situation or tool? Or just want to say hello?
        </p>
        <p class="text-gray-700 mb-6">
          Send us an email or reach out on social media. We read and appreciate every message.
        </p>

        <div class="space-y-4 mb-8">
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Email</h3>
            <p class="text-gray-700">
              <a href="mailto:hello@solvesteps.io" class="text-blue-600 hover:text-blue-700 underline">
                hello@solvesteps.io
              </a>
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Response Time</h3>
            <p class="text-gray-700">We try to respond within 48 hours.</p>
          </div>
        </div>

        <div class="bg-blue-50 p-4 rounded-lg">
          <p class="text-sm text-gray-700">
            <strong>Note:</strong> For urgent concerns related to mental health or safety, please contact local emergency services or crisis hotlines rather than us.
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Feedback Form</h2>
        <form class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Your Name</label>
            <input 
              type="text" 
              name="name"
              class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Your name"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Email</label>
            <input 
              type="email" 
              name="email"
              class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="your@email.com"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Subject</label>
            <select 
              name="subject"
              class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option>Feedback</option>
              <option>Bug Report</option>
              <option>Feature Suggestion</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Message</label>
            <textarea 
              name="message"
              class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Tell us what's on your mind..."
              rows="6"
              required
            ></textarea>
          </div>

          <p class="text-xs text-gray-600">
            We don't use contact forms to collect data. Send this email directly to us instead:
          </p>
          <a 
            href="mailto:hello@solvesteps.io" 
            class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold"
          >
            Email Us Your Feedback
          </a>
        </form>
      </div>
    </div>

    <div class="mt-16 pt-12 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">FAQ</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-semibold text-gray-900 mb-2">Is SolveSteps really free?</h3>
          <p class="text-gray-700">Yes, completely free. No ads, no tracking, no paid upgrades. We believe tools that help people should be accessible to everyone.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900 mb-2">Do you collect my data?</h3>
          <p class="text-gray-700">No. All your data stays on your device using browser storage. We don't collect, track, or sell any information about you or how you use SolveSteps.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900 mb-2">Can I download my plans?</h3>
          <p class="text-gray-700">Yes! The weekly planner and routine builder can be exported as CSV or text files. You can also print any page using your browser's print function.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900 mb-2">Will you add more situations?</h3>
          <p class="text-gray-700">Possibly! Send us your suggestions. We're always looking for real-life situations that people need help solving.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
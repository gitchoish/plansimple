---
import Layout from '../../layouts/Layout.astro';
import SituationChecklist from '../../components/SituationChecklist.astro';
---

<Layout 
  title="Weekly Cleaning Routine - SolveSteps" 
  description="Build a sustainable weekly cleaning routine. Daily and weekly tasks organized by room."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <a href="/situations" class="text-blue-600 hover:text-blue-700 text-sm font-semibold mb-4 inline-block">← Back to All Situations</a>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Weekly Cleaning Routine</h1>
      <p class="text-xl text-gray-600">Build a sustainable cleaning schedule that actually works for your life.</p>
    </div>

    <div class="bg-blue-50 p-6 rounded-lg mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Why a Routine Works</h2>
      <p class="text-gray-700 mb-3">
        Instead of letting mess accumulate until you do a massive "clean day," a weekly routine spreads tasks throughout the week. Each day takes 15-30 minutes, your home stays consistently clean, and you're not overwhelmed.
      </p>
      <p class="text-gray-700">
        Use the checklist below to create your ideal routine. Customize it based on your home size, how many people live there, and how much time you can dedicate.
      </p>
    </div>

    <SituationChecklist 
      title="Weekly Cleaning Routine"
      situationId="cleaning-routine"
      steps={[
        "Monday: Vacuum bedrooms and living areas",
        "Monday: Dust surfaces and furniture",
        "Tuesday: Clean bathrooms (toilet, sink, tub/shower)",
        "Tuesday: Mop bathroom floors",
        "Wednesday: Clean kitchen surfaces and appliances",
        "Wednesday: Wipe down cabinets and handles",
        "Thursday: Do laundry (sheets, towels, linens)",
        "Thursday: Change bed sheets",
        "Friday: Mop hard floors in main areas",
        "Friday: Clean mirrors and windows",
        "Saturday: Wipe down all baseboards",
        "Saturday: Clean out refrigerator",
        "Sunday: Do final tidying and decluttering",
        "Sunday: Plan next week's routine"
      ]}
    />

    <div class="grid md:grid-cols-2 gap-6 my-12">
      <div class="bg-white p-6 border-l-4 border-green-600 rounded-lg shadow">
        <h3 class="font-semibold text-gray-900 mb-3">🎯 Daily Habits</h3>
        <ul class="text-sm text-gray-700 space-y-2">
          <li>• Make your bed</li>
          <li>• Wash dishes immediately</li>
          <li>• Wipe down bathroom sink</li>
          <li>• Put items back where they belong</li>
          <li>• Do one load of laundry</li>
        </ul>
      </div>

      <div class="bg-white p-6 border-l-4 border-blue-600 rounded-lg shadow">
        <h3 class="font-semibold text-gray-900 mb-3">✨ Monthly Deep Clean</h3>
        <ul class="text-sm text-gray-700 space-y-2">
          <li>• Clean inside oven</li>
          <li>• Wash windows inside and out</li>
          <li>• Clean behind/under furniture</li>
          <li>• Wipe down light fixtures</li>
          <li>• Clean inside fridge thoroughly</li>
        </ul>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg">
      <h3 class="font-semibold text-gray-900 mb-2">💡 Customize for Your Home</h3>
      <p class="text-sm text-gray-700 mb-4">
        Edit the checklist above to match your situation. Small apartment? Fewer tasks. Large house? More time needed. Multiple people living together? Divide and assign tasks. The goal is to create a routine that's realistic for YOU.
      </p>
    </div>
  </div>
</Layout>
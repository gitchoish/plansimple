---
import Layout from '../../layouts/Layout.astro';
import SituationChecklist from '../../components/SituationChecklist.astro';
---

<Layout 
  title="Moving to a New Apartment - SolveSteps" 
  description="Step-by-step guide to moving apartments with interactive checklist. Track packing, utilities, address changes, and more."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <a href="/situations" class="text-blue-600 hover:text-blue-700 text-sm font-semibold mb-4 inline-block">← Back to All Situations</a>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Moving to a New Apartment</h1>
      <p class="text-xl text-gray-600">A comprehensive checklist to make your move smooth and stress-free.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="bg-blue-50 p-4 rounded-lg">
        <div class="text-sm font-semibold text-gray-900 mb-2">⏱️ Time Frame</div>
        <p class="text-sm text-gray-700">4-6 weeks before to 2 weeks after</p>
      </div>
      <div class="bg-green-50 p-4 rounded-lg">
        <div class="text-sm font-semibold text-gray-900 mb-2">📋 Tool</div>
        <p class="text-sm text-gray-700">Interactive Checklist</p>
      </div>
      <div class="bg-orange-50 p-4 rounded-lg">
        <div class="text-sm font-semibold text-gray-900 mb-2">👥 Who's This For?</div>
        <p class="text-sm text-gray-700">Anyone planning a move</p>
      </div>
    </div>

    <div class="space-y-12">
      <!-- Overview Section -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Overview</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Moving to a new apartment involves dozens of tasks across different categories: packing, logistics, utilities, address changes, and final walkthrough. This guide breaks it down into manageable steps so nothing falls through the cracks.
        </p>
        <p class="text-gray-700 leading-relaxed">
          The key is planning ahead. Start 4-6 weeks before your move and use the checklist below to track each step. Print it out, save it digitally, or both—it's yours to customize.
        </p>
      </section>

      <!-- Timeline Section -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Suggested Timeline</h2>
        <div class="space-y-4">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">6 weeks out</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">Research & Plan</p>
              <p class="text-sm">Find apartments, compare neighborhoods, start budget planning</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">4-5 weeks out</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">Sign Lease & Notify Current</p>
              <p class="text-sm">Sign lease, give notice to current landlord, inform employer if needed</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">2-3 weeks out</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">Organize & Sort</p>
              <p class="text-sm">Declutter, start collecting boxes, notify utilities and services</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">1 week out</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">Intensive Packing</p>
              <p class="text-sm">Pack most items, confirm moving truck/helpers, finalize utilities</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">Moving day</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">The Move</p>
              <p class="text-sm">Pack final items, do final walkthrough, transfer utilities</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-24 font-semibold text-gray-900">After move</div>
            <div class="text-gray-700">
              <p class="font-semibold mb-1">Settle In</p>
              <p class="text-sm">Unpack, update address everywhere, return old keys</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Interactive Checklist -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Moving Checklist</h2>
        <p class="text-gray-700 mb-6">
          Check off items as you complete them. Your progress is saved automatically on your device. Feel free to customize this list by adding your own steps.
        </p>

        <SituationChecklist 
          title="Moving to a New Apartment"
          situationId="moving-apartment"
          steps={[
            "Research neighborhoods and apartment listings",
            "Schedule apartment viewings",
            "Make decision and write offer",
            "Sign lease agreement",
            "Give 30-day notice to current landlord",
            "Gather moving boxes and packing supplies",
            "Start decluttering and sorting belongings",
            "Notify employer of address change if needed",
            "Contact utility companies (electricity, gas, water, internet)",
            "Schedule disconnect at old apartment",
            "Schedule connect at new apartment",
            "Update address with postal service",
            "Notify insurance companies of move",
            "Pack non-essential items (off-season clothes, books, etc.)",
            "Book moving truck or hire movers",
            "Recruit helpers if doing DIY move",
            "Arrange for parking if in city",
            "Take photos of old apartment condition",
            "Pack kitchen and living room items",
            "Pack bedroom items (except daily use)",
            "Pack bathroom items (except daily use)",
            "Confirm utilities disconnect/connect dates",
            "Do final walkthrough of old apartment",
            "Pack remaining items",
            "Clean old apartment thoroughly",
            "Collect cleaning deposits if applicable",
            "Transport items to new apartment",
            "Unpack essential items first",
            "Test utilities at new apartment",
            "Update address with bank and financial institutions",
            "Update address with employer",
            "Return keys to old apartment",
            "Update address with subscriptions and services",
            "Unpack and organize new apartment",
            "Take photos of new apartment condition"
          ]}
        />
      </section>

      <!-- Tips Section -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Pro Tips</h2>
        <div class="space-y-4">
          <div class="bg-white p-4 border-l-4 border-blue-600 rounded">
            <h3 class="font-semibold text-gray-900 mb-2">📦 Packing Strategy</h3>
            <p class="text-sm text-gray-700">Pack room-by-room and label boxes clearly with room and contents. Use color-coded tape for different rooms. Leave a "first day" box unpacked with essentials.</p>
          </div>
          <div class="bg-white p-4 border-l-4 border-green-600 rounded">
            <h3 class="font-semibold text-gray-900 mb-2">💰 Budget Tip</h3>
            <p class="text-sm text-gray-700">Moving costs add up quickly. Get quotes from multiple movers, consider DIY, and watch for hidden fees like stairs or long carries.</p>
          </div>
          <div class="bg-white p-4 border-l-4 border-orange-600 rounded">
            <h3 class="font-semibold text-gray-900 mb-2">📋 Address Change Checklist</h3>
            <p class="text-sm text-gray-700">Don't forget: USPS, banks, insurance, subscriptions, employer, medical/dental offices, utility companies, and voter registration.</p>
          </div>
          <div class="bg-white p-4 border-l-4 border-purple-600 rounded">
            <h3 class="font-semibold text-gray-900 mb-2">🔍 Final Walkthrough</h3>
            <p class="text-sm text-gray-700">Check every closet, cupboard, and drawer. Take photos of the empty apartment's condition. Make sure utilities are turned off.</p>
          </div>
        </div>
      </section>

      <!-- Common Mistakes Section -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Avoid These Common Mistakes</h2>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-3">
            <span class="text-red-600 font-bold">✗</span>
            <span><strong>Starting to pack too late:</strong> Give yourself at least 2-3 weeks. Last-minute packing causes forgotten items and stress.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-red-600 font-bold">✗</span>
            <span><strong>Not giving proper notice:</strong> Always give your current landlord at least 30 days notice. Check your lease for requirements.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-red-600 font-bold">✗</span>
            <span><strong>Forgetting utility changes:</strong> Contact providers at least 2 weeks ahead. Forgetting disconnects/connects causes interruptions.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-red-600 font-bold">✗</span>
            <span><strong>Not updating address in all places:</strong> Keep a list and work through it systematically. Missing places can cause mail issues.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-red-600 font-bold">✗</span>
            <span><strong>Skipping the final walkthrough:</strong> Do a thorough check for left-behind items, damage, and cleanliness. This protects your deposit.</span>
          </li>
        </ul>
      </section>

      <!-- Disclaimer -->
      <section class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">📝 Disclaimer</h3>
        <p class="text-sm text-gray-700">
          This guide provides general guidance for moving apartments. Specific requirements vary by location, lease terms, and situation. Always review your lease, local laws, and consult with landlords or professionals as needed.
        </p>
      </section>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-center text-gray-600 text-sm">
        💡 <strong>Tip:</strong> Print this page or bookmark it. Your checklist progress is saved automatically on this device.
      </p>
    </div>
  </div>
</Layout>